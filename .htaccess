# Bảo mật cho thư mục gốc website (Apache). Áp dụng cả khi đưa nguyên mã nguồn lên hosting.
Options -Indexes
ServerSignature Off
# Đường dẫn không tồn tại: hiện trang 404 thân thiện của website thay vì trang lỗi mặc định của máy chủ
ErrorDocument 404 /frontend/404.html

# SEO: trang gốc tên miền chuyển hẳn (301) sang trang chủ website trong frontend/, để Google gộp về 1 địa chỉ
# (thay cho trang chuyển hướng bằng JavaScript). Đường dẫn tương đối nên vẫn đúng khi cài trong thư mục con.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # %2 = thư mục cài website (vd "/" hoặc "/thu-muc-con/"), tự tính từ địa chỉ đang mở
  RewriteCond $0#%{REQUEST_URI} ^([^#]*)#(.*)\1$
  RewriteRule ^(index\.html)?$ %2frontend/ [R=301,L]
  # Khi tên miền đã chạy HTTPS ổn định, bỏ dấu # 2 dòng dưới để luôn dùng https://nhathaudienlanhkhanhle.vn (không www):
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteRule ^ https://nhathaudienlanhkhanhle.vn%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # setifempty: API (PHP) đã tự đặt header chặt hơn thì giữ của PHP. Chống đoán sai loại tệp, chống nhúng trang vào web lừa đảo (clickjacking), hạn chế lộ đường dẫn.
  Header setifempty X-Content-Type-Options "nosniff"
  Header setifempty X-Frame-Options "SAMEORIGIN"
  Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
  Header setifempty Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# Không cho tải tệp ẩn (.git, .env, .htaccess...) và thư mục / tệp chỉ dùng khi phát triển.
RedirectMatch 404 /\.(?!well-known/)
RedirectMatch 404 /(tests|tools|docs|supabase|node_modules)(/|$)
<FilesMatch "\.(md|log|sql|lock|ya?ml|sh|bak|old|orig|swp|ini|env|dist|tsx?|mjs|map)$|^(package(-lock)?\.json|tsconfig\.json|composer\.(json|lock)|vite\.config\..*)$">
  Require all denied
</FilesMatch>

# Tốc độ khi nhiều khách cùng vào: nén văn bản; file JS/CSS có mã băm trong tên (react-assets) không bao giờ đổi
# nội dung → trình duyệt giữ 1 năm, lần sau không tải lại. Ảnh giữ 7 ngày.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "-(?=[A-Za-z0-9_-]*[A-Z0-9])[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
