 export function uniqueCategories(){return dt.categories.filter((c,index,all)=>all.findIndex(other=>dt.u.norm(other.short || other.name.replace(/\[TEST[^\]]*\]\s*/gi,''))===dt.u.norm(c.short || c.name.replace(/\[TEST[^\]]*\]\s*/gi,'')))===index);}
